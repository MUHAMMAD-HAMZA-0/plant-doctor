{
  "expo": {
    "name": "plant care",
    "slug": "plant-care",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/plant.png",
    "scheme": "plantcare",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow access to your photo library to select plant images.",
        "NSCameraUsageDescription": "Allow camera access to take plant photos."
      },
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/plant.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.salman7937.plantcare"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/plant.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/plant.png",
          "resizeMode": "cover",
          "backgroundColor": "#000000",
          "android": {
            "resizeMode": "cover",
            "backgroundColor": "#000000"
          },
          "ios": {
            "resizeMode": "cover",
            "backgroundColor": "#000000"
          },
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bf5dbb8f-d34c-4377-9124-503ec2c336ec"
      }
    }
  }
}
